# Copy this file to .env and fill in your own values. .env is gitignored.

# Hugging Face token (only needed if the model/dataset requires auth; JBB-Behaviors
# and Qwen2.5-Instruct are both ungated, so this can usually be left blank).
HF_TOKEN=

# Used only for the Phase 1 latency-comparison baseline (a full LLM call
# classifying the same prompt) and, optionally, generating paraphrased
# jailbreak variants for a later generalization test. Keep usage minimal.
OPENAI_API_KEY=

# Postgres connection for request logging (docker-compose provides a local instance)
DATABASE_URL=postgresql://probe:probe@localhost:5433/activation_probe

# Same Postgres instance, broken into fields for dbt's profiles.yml (dbt/profiles.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=probe
POSTGRES_PASSWORD=probe
POSTGRES_DB=activation_probe
